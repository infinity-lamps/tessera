# Public tessera repo, main branch: guides, printable parts, README, licences.
# Kept deliberately short. The previous file was GitHub's Visual Studio
# template, which silently ignored any folder named release/, bin/ or logs/
# (so parts/release/hub.step would never have been published).

# OS and editor clutter
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.tmp
*.bak

# Office lock files (~$Guide.docx etc.)
~$*

# Half-finished downloads from the pull script
*.partial
